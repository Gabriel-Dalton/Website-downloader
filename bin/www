#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('website-downloader:server');
var http = require('http');

/**
 * Get port from environment and store in Express.
 */

// 3000 is reserved for the Just Us platform — its SSO callback is registered
// as http://localhost:3000/verify, so sign-in breaks on any other port and a
// squatter here silently pushes Next.js to 3001. Refuse 3000 even when PORT
// asks for it explicitly: this server also serves crawled sites, which leaves
// their cookies and service workers on whatever origin it occupies.
var RESERVED_PORT = 3000;
var FALLBACK_PORT = 3300;
var port = normalizePort(process.env.PORT || String(FALLBACK_PORT));
if (port === RESERVED_PORT) {
  console.warn(
    '[www] port ' + RESERVED_PORT + ' is reserved for the Just Us platform; using ' +
    FALLBACK_PORT + ' instead.'
  );
  port = FALLBACK_PORT;
}
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);
var io = require('socket.io')(server);

// Pass socket Object to it's modula 
require('../socket/socket')(io)
/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port, onListening);
server.on('error', onError);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
