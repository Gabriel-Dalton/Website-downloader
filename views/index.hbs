<div class="wrap">

  <div class="masthead">
    <h1>Website Downloader</h1>
    <p class="tagline">Mirror a site to a folder you can browse offline, assets included.</p>
  </div>

  <form class="download-form" id="downloadForm">
    <input type="text" id="website" placeholder="example.com" autocomplete="off"
           spellcheck="false" aria-label="Website address">
    <button type="button" id="download">Download</button>
  </form>
  <p class="hint">Stylesheets, scripts, images and fonts are picked up too, including
    the ones served from a CDN. Large sites can take several minutes.</p>

  <div class="progress" id="progress" hidden role="progressbar" aria-label="Downloading"></div>

  <div class="stats" id="stats" hidden>
    <span>Files fetched <b id="nFiles">0</b></span>
  </div>

  <p class="log" id="log" aria-live="polite"></p>

  <div class="msg msg-error" id="errorBox" hidden role="alert"></div>
  <div class="msg msg-warning" id="warnBox" hidden></div>

  <div class="msg msg-ok" id="okBox" hidden>
    <p id="okText">Archive ready.</p>
    <button type="button" id="downloadWebsite">Save the zip</button>
  </div>

  <div class="foot">
    <p>Runs on your machine. Nothing is uploaded anywhere.</p>
    <p><a href="https://github.com/Gabriel-Dalton/Website-downloader">Source and setup guide</a></p>
  </div>

</div>
