<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <!-- Served by this app, not a CDN. A tool for working offline should not
         need the internet to render its own page. -->
    <script src="/socket.io/socket.io.js"></script>
  </head>
  <body>
    {{{body}}}

<script>
  var socket = io.connect(document.URL);

  var form     = document.getElementById('downloadForm');
  var input    = document.getElementById('website');
  var startBtn = document.getElementById('download');

  var work      = document.getElementById('work');
  var workLabel = document.getElementById('workLabel');
  var barFill   = document.getElementById('barFill');
  var current   = document.getElementById('current');

  var mPagesWrap  = document.getElementById('mPagesWrap');
  var mPages      = document.getElementById('mPages');
  var mFiles      = document.getElementById('mFiles');
  var mBytes      = document.getElementById('mBytes');
  var mElapsed    = document.getElementById('mElapsed');
  var mRemainWrap = document.getElementById('mRemainWrap');
  var mRemain     = document.getElementById('mRemain');

  var errorBox = document.getElementById('errorBox');
  var warnBox  = document.getElementById('warnBox');
  var okBox    = document.getElementById('okBox');
  var okText   = document.getElementById('okText');
  var saveBtn  = document.getElementById('downloadWebsite');

  // Elapsed is ticked here rather than taken from the server, so the clock
  // keeps moving during a long fetch that produces no output at all.
  var startedAt = 0;
  var ticker = null;

  if (!localStorage['token']) localStorage['token'] = generateToken(20);

  socket.on(localStorage['token'], function (event) {
    if (event.error) {
      stop();
      errorBox.textContent = event.error;
      errorBox.hidden = false;
      return;
    }

    if (event.stats) {
      render(event.stats);
      return;
    }

    if (event.progress === 'Converting') {
      workLabel.textContent = 'Compressing the archive…';
      current.textContent = '';
      mRemainWrap.hidden = true;
      barFill.className = 'bar-fill';
      return;
    }

    if (event.progress === 'Completed') {
      stop();
      work.hidden = true;
      okText.textContent = 'Archive ready.';
      okBox.hidden = false;
      saveBtn.onclick = function () {
        window.location = '/sites/' + event.file + '.zip';
      };
      // A finished download is not always a complete one.
      if (event.warning) {
        warnBox.textContent = event.warning;
        warnBox.hidden = false;
      }
      return;
    }

    // Anything else is a one-off note from the server, such as which asset
    // hosts were included or skipped.
    if (typeof event.progress === 'string' && event.progress.trim()) {
      // textContent, not innerHTML: some of this echoes the site being
      // downloaded and must never be parsed as markup.
      current.textContent = event.progress.trim();
    }
  });

  function render(s) {
    work.hidden = false;
    workLabel.textContent = 'Fetching files…';

    mFiles.textContent = s.files.toLocaleString();
    mBytes.textContent = formatBytes(s.bytes);

    if (s.totalPages) {
      mPagesWrap.hidden = false;
      mPages.textContent = s.pages.toLocaleString() + ' / ' + s.totalPages.toLocaleString();
      var pct = Math.max(2, Math.min(100, Math.round(s.pages / s.totalPages * 100)));
      barFill.className = 'bar-fill known';
      barFill.style.width = pct + '%';
    }

    if (s.remainingMs) {
      mRemainWrap.hidden = false;
      mRemain.textContent = '~' + formatDuration(s.remainingMs);
    }

    if (s.current) current.textContent = s.current;
  }

  function startDownload() {
    var website = input.value.trim();
    if (!website) { input.focus(); return; }

    errorBox.hidden = true;
    warnBox.hidden = true;
    okBox.hidden = true;
    mPagesWrap.hidden = true;
    mRemainWrap.hidden = true;
    mFiles.textContent = '0';
    mBytes.textContent = '0 MB';
    mElapsed.textContent = '0:00';
    current.textContent = '';
    barFill.className = 'bar-fill';
    barFill.style.width = '';
    workLabel.textContent = 'Looking up where the assets live…';
    work.hidden = false;

    startBtn.disabled = true;
    startBtn.textContent = 'Working…';

    startedAt = Date.now();
    clearInterval(ticker);
    ticker = setInterval(function () {
      mElapsed.textContent = formatDuration(Date.now() - startedAt);
    }, 1000);

    socket.emit('request', { token: localStorage['token'], website: website });
  }

  function stop() {
    clearInterval(ticker);
    ticker = null;
    startBtn.disabled = false;
    startBtn.textContent = 'Download';
  }

  function formatBytes(n) {
    if (!n) return '0 MB';
    if (n < 1048576) return (n / 1024).toFixed(0) + ' KB';
    if (n < 1073741824) return (n / 1048576).toFixed(1) + ' MB';
    return (n / 1073741824).toFixed(2) + ' GB';
  }

  function formatDuration(ms) {
    var total = Math.max(0, Math.round(ms / 1000));
    var h = Math.floor(total / 3600);
    var m = Math.floor((total % 3600) / 60);
    var s = total % 60;
    if (h) return h + ':' + pad(m) + ':' + pad(s);
    return m + ':' + pad(s);
  }

  function pad(n) { return n < 10 ? '0' + n : String(n); }

  startBtn.onclick = startDownload;
  // Without this, Enter submits the form and navigates away from the page.
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    startDownload();
  });

  socket.on('disconnect', function () {
    stop();
    work.hidden = true;
    errorBox.textContent = 'Lost the connection to the server. Is it still running?';
    errorBox.hidden = false;
  });

  function generateToken(n) {
    var chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    var token = '';
    for (var i = 0; i < n; i++) {
      token += chars[Math.floor(Math.random() * chars.length)];
    }
    return token;
  }
</script>
  </body>
</html>
