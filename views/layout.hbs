<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <!-- Served by this app, not a CDN. A tool for working offline should not
         need the internet to render its own page. -->
    <script src="/socket.io/socket.io.js"></script>
  </head>
  <body>
    {{{body}}}

<script>
  var socket = io.connect(document.URL);

  var form       = document.getElementById('downloadForm');
  var input      = document.getElementById('website');
  var startBtn   = document.getElementById('download');
  var progress   = document.getElementById('progress');
  var stats      = document.getElementById('stats');
  var nFiles     = document.getElementById('nFiles');
  var log        = document.getElementById('log');
  var errorBox   = document.getElementById('errorBox');
  var warnBox    = document.getElementById('warnBox');
  var okBox      = document.getElementById('okBox');
  var okText     = document.getElementById('okText');
  var saveBtn    = document.getElementById('downloadWebsite');

  var fileCount = 0;

  if (!localStorage['token']) localStorage['token'] = generateToken(20);

  socket.on(localStorage['token'], function (event) {
    if (event.error) {
      finish();
      errorBox.textContent = event.error;
      errorBox.hidden = false;
      return;
    }

    if (event.progress === 'Converting') {
      log.textContent = 'Compressing the archive...';
      return;
    }

    if (event.progress === 'Completed') {
      finish();
      log.textContent = '';
      okText.textContent = 'Archive ready.';
      okBox.hidden = false;
      saveBtn.onclick = function () {
        window.location = '/sites/' + event.file + '.zip';
      };
      // A finished download is not always a complete one.
      if (event.warning) {
        warnBox.textContent = event.warning;
        warnBox.hidden = false;
      }
      return;
    }

    // Anything else is raw wget output. Count the successful fetches and show
    // the most recent meaningful line rather than every chunk.
    var text = String(event.progress || '');
    if (text.indexOf('200 OK') !== -1) {
      fileCount++;
      nFiles.textContent = fileCount;
    }
    stats.hidden = false;
    progress.hidden = false;
    var lines = text.split('\n');
    for (var i = lines.length - 1; i >= 0; i--) {
      if (lines[i].trim()) {
        // textContent, not innerHTML: this comes from the site being
        // downloaded and must never be parsed as markup.
        log.textContent = lines[i].trim();
        break;
      }
    }
  });

  function startDownload() {
    var website = input.value.trim();
    if (!website) { input.focus(); return; }

    fileCount = 0;
    nFiles.textContent = '0';
    log.textContent = 'Starting...';
    errorBox.hidden = true;
    warnBox.hidden = true;
    okBox.hidden = true;
    stats.hidden = true;
    progress.hidden = false;
    startBtn.disabled = true;
    startBtn.textContent = 'Working...';

    socket.emit('request', { token: localStorage['token'], website: website });
  }

  function finish() {
    progress.hidden = true;
    startBtn.disabled = false;
    startBtn.textContent = 'Download';
  }

  startBtn.onclick = startDownload;
  // Without this, Enter submits the form and navigates away from the page.
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    startDownload();
  });

  socket.on('disconnect', function () {
    finish();
    errorBox.textContent = 'Lost the connection to the server. Is it still running?';
    errorBox.hidden = false;
  });

  function generateToken(n) {
    var chars = 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
    var token = '';
    for (var i = 0; i < n; i++) {
      token += chars[Math.floor(Math.random() * chars.length)];
    }
    return token;
  }
</script>
  </body>
</html>
